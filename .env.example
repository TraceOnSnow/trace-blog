# Trace Blog optional environment variables
#
# The first version keeps Markdown content in this repository. Leave content
# synchronization disabled unless a separate private/public content repository
# is introduced later.
ENABLE_CONTENT_SYNC=false

# Optional separate content repository settings. Only used when
# ENABLE_CONTENT_SYNC=true.
# CONTENT_REPO_URL=https://github.com/TraceOnSnow/your-content-repo.git
# CONTENT_DIR=./content
# USE_SUBMODULE=false

# Optional IndexNow submission. Do not commit real keys.
# INDEXNOW_KEY=
# INDEXNOW_HOST=blog.treesonsnow.com

# Optional Bilibili session used only by the disabled Bilibili anime updater.
# BILI_SESSDATA=
