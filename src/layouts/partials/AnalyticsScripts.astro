---
/**
 * AnalyticsScripts.astro
 * 可选的第三方分析脚本。
 * 当前仅支持通过站点配置显式启用 Microsoft Clarity。
 */

interface Props {
	thirdPartyAnalytics?: {
		enable: boolean;
		clarityId?: string;
	};
}

const { thirdPartyAnalytics = { enable: false, clarityId: "" } } = Astro.props;

const clarityEnable =
	thirdPartyAnalytics.enable && thirdPartyAnalytics.clarityId;
---

{
	clarityEnable && (
		<script
			is:inline
			define:vars={{ clarityId: thirdPartyAnalytics.clarityId }}
		>
			(function (c, l, a, r, i, t, y) {
				c[a] =
					c[a] ||
					function () {
						(c[a].q = c[a].q || []).push(arguments);
					};
				t = l.createElement(r);
				t.async = 1;
				t.src = "https://www.clarity.ms/tag/" + i;
				y = l.getElementsByTagName(r)[0];
				y.parentNode.insertBefore(t, y);
			})(window, document, "clarity", "script", clarityId);
		</script>
	)
}
